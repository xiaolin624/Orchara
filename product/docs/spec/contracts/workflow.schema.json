{
  "type": "object",
  "properties": {
    "dsl_version": {
      "const": "1.0"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "start",
              "end",
              "model",
              "agent",
              "python",
              "call_app",
              "retrieve",
              "condition",
              "join",
              "approval"
            ]
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "literal": {}
                  },
                  "required": [
                    "literal"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^(input|node:[A-Za-z][A-Za-z0-9_-]*)#(/.*)?$"
                    }
                  },
                  "required": [
                    "ref"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "output_schema": {
            "type": "object"
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "type",
          "inputs",
          "output_schema",
          "config"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "start"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "end"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "model"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "model_profile_version": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "prompt_template": {
                      "type": "string"
                    },
                    "response_mode": {
                      "type": "string",
                      "enum": [
                        "text",
                        "json"
                      ]
                    }
                  },
                  "required": [
                    "model_profile_version",
                    "prompt_template",
                    "response_mode"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "agent"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "model_profile_version": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "instructions": {
                      "type": "string"
                    },
                    "tool_versions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "uniqueItems": true
                    },
                    "subapp_versions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "uniqueItems": true
                    },
                    "max_turns": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    }
                  },
                  "required": [
                    "model_profile_version",
                    "instructions",
                    "tool_versions",
                    "subapp_versions",
                    "max_turns"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "python"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "tool_version": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "tool_version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "call_app"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "application_version": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "application_version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "retrieve"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "knowledge_base_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "top_k": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    }
                  },
                  "required": [
                    "knowledge_base_ids",
                    "top_k"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "condition"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "join_id": {
                      "type": "string"
                    },
                    "default_port": {
                      "type": "string"
                    },
                    "cases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": "string"
                          },
                          "op": {
                            "type": "string",
                            "enum": [
                              "eq",
                              "ne",
                              "gt",
                              "gte",
                              "lt",
                              "lte",
                              "in",
                              "exists"
                            ]
                          },
                          "value": {},
                          "port": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "input",
                          "op",
                          "port"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "join_id",
                    "default_port",
                    "cases"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "join"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "all_active"
                      ]
                    },
                    "fork_id": {
                      "type": "string"
                    },
                    "required_sources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "optional_sources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "mode",
                    "fork_id",
                    "required_sources",
                    "optional_sources"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "approval"
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "expires_seconds": {
                      "type": "integer",
                      "minimum": 60,
                      "maximum": 86400
                    }
                  },
                  "required": [
                    "title",
                    "expires_seconds"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      },
      "minItems": 2,
      "maxItems": 100
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "port": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "target"
        ],
        "additionalProperties": false
      },
      "maxItems": 400
    },
    "policy": {
      "type": "object",
      "properties": {
        "max_active_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_child_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_child_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "budget_limit": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": [
        "max_active_seconds",
        "max_child_depth",
        "max_child_calls",
        "budget_limit",
        "currency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "dsl_version",
    "input_schema",
    "output_schema",
    "nodes",
    "edges",
    "policy"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-platform:workflow:1.0",
  "title": "Agent platform execution definition"
}
