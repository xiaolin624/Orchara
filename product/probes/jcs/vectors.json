  {
    "name": "rfc8785-sort-order",
    "source": "RFC 8785 section 3.2.3 sort verification data (U+FB33 kept precomposed: JCS does not normalise)",
    "input_json": "{\"\\u20ac\": \"Euro Sign\", \"\\r\": \"Carriage Return\", \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\", \"1\": \"One\", \"\\ud83d\\ude00\": \"Emoji: Grinning Face\", \"\\u0080\": \"Control\", \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"}",
    "expected_canonical": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"}",
    "expected_hex": null,
    "error": null,
    "expected_sha256": "5e321556d22018a9656991a9e94f77ec175fa193e52a2429d312f8419ec8b08c"
  },
  {
    "name": "utf16-vs-codepoint-sort",
    "source": "derived: U+1F600 is D83D DE00 in UTF-16, which sorts before U+E000; code-point order is the opposite",
    "input_json": "{\"\\ue000\": \"private use\", \"\\ud83d\\ude00\": \"emoji\"}",
    "expected_canonical": "{\"\ud83d\ude00\":\"emoji\",\"\ue000\":\"private use\"}",
    "expected_hex": null,
    "error": null,
    "expected_sha256": "9ad38f6e50794f1ee248b80027707e74932249af207322ceb60994a9f4c0b765"
  },
