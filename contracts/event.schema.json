{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "run.status",
        "node.status",
        "approval.required",
        "artifact.ready",
        "usage.updated"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "seq",
    "revision",
    "type",
    "created_at",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "node.status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "attempt_no": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "node_id",
              "state",
              "attempt_no"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval.required"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "approval_id": {
                "type": "string",
                "format": "uuid"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "approval_id",
              "expires_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact.ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "format": "uuid"
              },
              "media_type": {
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "media_type"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "usage.updated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string"
              },
              "charged": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              "reserved": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              }
            },
            "required": [
              "currency",
              "charged",
              "reserved"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
